Bootstrap: docker
From: pytorch/pytorch:2.13.0-cuda12.6-cudnn9-runtime

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        git wget curl build-essential \
        samtools bedtools tabix \
        libcurl4-openssl-dev libssl-dev libbz2-dev liblzma-dev zlib1g-dev
    rm -rf /var/lib/apt/lists/*

    # Don't touch setuptools; there's no need to for a --no-deps install
    # below, and some base torch builds pin it against their own build.
    python -m pip install --upgrade pip wheel

    # Install non-PyTorch Cherimoya dependencies while preserving the
    # base image's own torch/torchvision build (torch 2.13.0, CUDA 12.6).
    python -m pip install pynvml \
        numpy scipy pandas h5py tqdm seaborn modisco tangermeme \
        bam2bw joblib

    # bpnet-lite declares an unconditional macs3 dependency that nothing in
    # this repo calls; --no-deps skips it (bpnetlite.performance, the only
    # submodule Cherimoya's scripts import, only needs torch and its own
    # .losses module, both already present).
    python -m pip install --no-deps bpnet-lite

    # Cherimoya + likely genomics/CLI dependencies. --no-deps avoids replacing
    # the base image's torch 2.13.0 build with a fresh PyPI resolve. Installed
    # from the v0.2.0 git tag rather than the PyPI wheel; cherimoya has no
    # compiled extensions, so this is equivalent, and matches how prior
    # cherimoya versions were installed here.
    python -m pip install --no-deps "cherimoya @ git+https://github.com/jmschrei/cherimoya.git@v0.2.0"

    # Optional but useful for source/debugging
    python -m pip install pytest ipython jupyter pandas polars pyBigWig pysam

%environment
    export PYTHONNOUSERSITE=1
    export NUMBA_CACHE_DIR=/tmp/numba_cache/
    export TORCHINDUCTOR_CACHE_DIR=/tmp/torchinductor_cache
    export TRITON_CACHE_DIR=/tmp/triton_cache
    export XDG_CACHE_HOME=/tmp/.cache

%runscript
    exec "$@"
